#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
#include "Generated.xcconfig"

// iPhone Duo's fold APIs (UIHingeInteraction, reserved division regions) exist
// only in the iOS 27.1 SDK and later. Both Xcode 27.0 and 27.1 ship the same
// Swift, so the source can't tell them apart: turn the code on per SDK here.
SWIFT_ACTIVE_COMPILATION_CONDITIONS[sdk=iphoneos27.1*] = $(inherited) EMOJIO_SDK_27_1
SWIFT_ACTIVE_COMPILATION_CONDITIONS[sdk=iphonesimulator27.1*] = $(inherited) EMOJIO_SDK_27_1
SWIFT_ACTIVE_COMPILATION_CONDITIONS[sdk=iphoneos27.2*] = $(inherited) EMOJIO_SDK_27_1
